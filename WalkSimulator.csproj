<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assetbundle" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assetbundle" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExAssemblyPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExAssemblyPath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utilla">
      <HintPath>$(PluginsPath)\Utilla\Utilla.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Reference every game assembly except the BCL ones netstandard already provides -->
  <ItemGroup>
    <Reference Include="$(GameAssemblyPath)\*.dll"
               Exclude="$(GameAssemblyPath)\mscorlib.dll;$(GameAssemblyPath)\netstandard.dll;$(GameAssemblyPath)\System.*.dll;$(GameAssemblyPath)\System.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
